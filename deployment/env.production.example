# Database configuration
POSTGRES_USER=tem_barber_user
POSTGRES_PASSWORD=generate_a_very_strong_password_here
POSTGRES_DB=tem_barber
DATABASE_URL=postgresql://tem_barber_user:generate_a_very_strong_password_here@postgres:5432/tem_barber?schema=public

# NextAuth configuration
NEXTAUTH_SECRET=generate_a_secure_nextauth_secret_with_openssl_rand_hex_32
NEXTAUTH_URL=https://app.tembarber.com.br

# Internal D2B scheduler authentication (provision a high-entropy value in production)
D2B_JOB_SECRET=

# Application environment
NODE_ENV=production

# Platform configuration
PLATFORM_ADMIN_EMAILS=max.guarinieri@gmail.com

# Web Push VAPID Configuration (P0.1)
# Note: VAPID_PRIVATE_KEY is server-only and must never be exposed or committed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://app.tembarber.com.br
