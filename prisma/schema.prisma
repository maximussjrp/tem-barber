datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. USUÁRIOS E CONTROLE DE ACESSO
// ----------------------------------------------------

enum UserRole {
  SUPER_ADMIN // Administrador global da plataforma (Match Barber)
  USER // Cliente final que agenda horários
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String?  @unique // Opcional para clientes, obrigatório para staff/admin
  phone        String   @unique // Obrigatório e único para todos (chave de login do cliente)
  cpf          String?  @unique // Opcional para clientes, obrigatório para staff/admin
  passwordHash String?  @map("password_hash") // Opcional para clientes (login sem senha)
  role         UserRole @default(USER)
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  memberships                   BarbershopMember[] // Caso o usuário seja funcionário/dono de barbearia
  appointments                  Appointment[] // Histórico de agendamentos como cliente
  reviews                       Review[] // Avaliações feitas pelo cliente
  notifications                 Notification[]
  comandas                      Comanda[]
  clubSubscriptions             CustomerClubSubscription[]
  clubSubscriptionPayments      ClubSubscriptionPayment[]
  whatsappConfirmations         AppointmentWhatsappConfirmation[]
  customerBarbershopLinks       CustomerBarbershopLink[]
  verifiedWhatsappCustomerLinks CustomerBarbershopLink[]          @relation("WhatsappVerifiedBy")
  createdWaitlistSessions       OnlineWaitlistSession[]
  onlineWaitlistEntries         OnlineWaitlistEntry[]
  comandaReopenAudits           ComandaReopenAudit[]
  comandaCancelAudits           ComandaCancelAudit[]              @relation("ComandaCancelledByUser")
  blockedCustomers              BarbershopBlockedCustomer[]
  blockedCustomersByMe          BarbershopBlockedCustomer[]       @relation("BlockedByUser")
  unblockedCustomersByMe        BarbershopBlockedCustomer[]       @relation("UnblockedByUser")

  @@map("users")
}

// ----------------------------------------------------
// 2. TENANTS (ESTABELECIMENTOS / BARBEARIAS)
// ----------------------------------------------------

model Barbershop {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique // Para URLs amigáveis: matchbarber.com.br/barbearia-do-ze
  logoUrl     String? @map("logo_url")
  coverUrl    String? @map("cover_url")
  description String?
  phone       String
  active      Boolean @default(true)

  // Endereço
  zipCode      String  @map("zip_code")
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  latitude     Float?
  longitude    Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  members                     BarbershopMember[]
  services                    Service[]
  categories                  Category[]
  appointments                Appointment[]
  subscriptions               TenantSubscription[]
  idempotencyKeys             IdempotencyKey[]
  comandas                    Comanda[]
  products                    Product[]
  cashSessions                CashSession[]
  financialEntries            FinancialEntry[]
  commissionConfigs           CommissionConfig[]
  commissionEntries           CommissionEntry[]
  commissionPeriods           CommissionPeriod[]
  commissionAdjustments       CommissionAdjustment[]
  careerLevels                CareerLevel[]
  serviceCommissionRules      ServiceCommissionRule[]
  clubPlans                   ClubPlan[]
  customerClubSubscriptions   CustomerClubSubscription[]
  clubSubscriptionPayments    ClubSubscriptionPayment[]
  clubBenefitUsages           ClubBenefitUsage[]
  clubPointEntries            ClubPointEntry[]
  clubSettlements             ClubSettlement[]
  whatsappConfirmations       AppointmentWhatsappConfirmation[]
  customerBarbershopLinks     CustomerBarbershopLink[]
  onlineWaitlistSessions      OnlineWaitlistSession[]
  onlineWaitlistEntries       OnlineWaitlistEntry[]
  onlineWaitlistMemberConfigs OnlineWaitlistMemberConfig[]
  asaasBillingCustomers       AsaasBillingCustomer[]
  asaasBillingSubscriptions   AsaasBillingSubscription[]
  asaasBillingPayments        AsaasBillingPayment[]
  asaasWebhookEvents          AsaasWebhookEvent[]
  billingProfile              BarbershopBillingProfile?
  comandaReopenAudits         ComandaReopenAudit[]
  comandaCancelAudits         ComandaCancelAudit[]
  blockedCustomers            BarbershopBlockedCustomer[]

  @@map("barbershops")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  barbershopId String   @map("barbershop_id")
  key          String
  requestHash  String   @map("request_hash")
  result       Json?
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// Papéis dentro de uma barbearia específica
enum MemberRole {
  OWNER // Dono da barbearia (acesso total administrativo)
  MANAGER // Gerente (acesso operacional e financeiro básico)
  BARBER // Barbeiro / Colaborador (vê apenas a própria agenda)
}

model BarbershopMember {
  id           String     @id @default(uuid())
  barbershopId String     @map("barbershop_id")
  userId       String     @map("user_id")
  role         MemberRole @default(BARBER)
  bio          String?
  ratingAvg    Float      @default(0.0) @map("rating_avg")
  isActive     Boolean    @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  barbershop               Barbershop                  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user                     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  services                 BarberService[]
  workingHours             WorkingHour[]
  timeOffs                 TimeOff[]
  appointments             Appointment[]
  comandaItems             ComandaItem[]
  commissionConfigs        CommissionConfig[]
  commissionEntries        CommissionEntry[]
  commissionPeriods        CommissionPeriod[]
  commissionAdjustments    CommissionAdjustment[]
  clubPointEntries         ClubPointEntry[]
  clubSettlementMembers    ClubSettlementMember[]
  preferredWaitlistEntries OnlineWaitlistEntry[]       @relation("WaitlistPreferredMember")
  calledWaitlistEntries    OnlineWaitlistEntry[]       @relation("WaitlistCalledByMember")
  onlineWaitlistConfig     OnlineWaitlistMemberConfig?
  comandaReopenAudits      ComandaReopenAudit[]
  comandaCancelAudits      ComandaCancelAudit[]        @relation("ComandaCancelledByMember")
  blockedCustomersByMe     BarbershopBlockedCustomer[] @relation("BlockedByMember")
  unblockedCustomersByMe   BarbershopBlockedCustomer[] @relation("UnblockedByMember")

  careerLevelId String?      @map("career_level_id")
  careerLevel   CareerLevel? @relation(fields: [careerLevelId], references: [id], onDelete: SetNull)

  @@unique([barbershopId, userId])
  @@index([careerLevelId])
  @@map("barbershop_members")
}

// ----------------------------------------------------
// 3. CATEGORIAS E SERVIÇOS
// ----------------------------------------------------

model Category {
  id           String @id @default(uuid())
  barbershopId String @map("barbershop_id")
  name         String
  slug         String

  barbershop        Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  services          Service[]
  commissionConfigs CommissionConfig[]

  @@unique([barbershopId, slug])
  @@map("categories")
}

model Service {
  id           String  @id @default(uuid())
  barbershopId String  @map("barbershop_id")
  categoryId   String  @map("category_id")
  name         String
  description  String?
  price        Decimal @db.Decimal(10, 2)
  durationMin  Int     @map("duration_min") // Duração do serviço em minutos
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  barbershop             Barbershop              @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  category               Category                @relation(fields: [categoryId], references: [id])
  barbers                BarberService[]
  appointments           AppointmentService[]
  comandaItems           ComandaItem[]
  commissionConfigs      CommissionConfig[]
  serviceCommissionRules ServiceCommissionRule[]
  clubPlanBenefits       ClubPlanBenefit[]
  clubBenefitUsages      ClubBenefitUsage[]
  onlineWaitlistEntries  OnlineWaitlistEntry[]

  @@map("services")
}

// Tabela dinâmica de associação N:N entre Barbeiro e Serviço
model BarberService {
  barberId  String @map("barber_id")
  serviceId String @map("service_id")

  barber  BarbershopMember @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("barber_services")
}

// ----------------------------------------------------
// 4. AGENDAS E HORÁRIOS
// ----------------------------------------------------

// Grade de horários padrão de trabalho do profissional (Ex: Seg a Sex, 09:00 às 18:00)
model WorkingHour {
  id        String @id @default(uuid())
  memberId  String @map("member_id")
  dayOfWeek Int    @map("day_of_week") // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado
  startTime String @map("start_time") // Formato "HH:MM"
  endTime   String @map("end_time") // Formato "HH:MM"

  // Horários de Intervalo (Almoço/Pausa)
  breakStart String? @map("break_start") // Formato "HH:MM"
  breakEnd   String? @map("break_end") // Formato "HH:MM"
  isActive   Boolean @default(true) @map("is_active")

  member BarbershopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, dayOfWeek])
  @@map("working_hours")
}

// Dias de folga, férias ou bloqueios temporários de agenda de um profissional
model TimeOff {
  id        String   @id @default(uuid())
  memberId  String   @map("member_id")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  reason    String? // Ex: "Férias", "Médico", "Bloqueio manual"
  allDay    Boolean  @default(false) @map("all_day")

  member BarbershopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("time_offs")
}

// ----------------------------------------------------
// 5. AGENDAMENTOS E FLUXO
// ----------------------------------------------------

enum AppointmentStatus {
  PENDING // Aguardando confirmação (caso a barbearia use aprovação manual)
  CONFIRMED // Confirmado e ativo
  COMPLETED // Serviço finalizado com sucesso
  CANCELLED // Cancelado pelo cliente ou estabelecimento
  NO_SHOW // Cliente não compareceu
}

enum AppointmentBookingMode {
  NORMAL
  FIT_IN
}

enum WhatsappConfirmationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELED
}

enum AppointmentWhatsappConfirmationMethod {
  TOKEN
  MANUAL_OVERRIDE
}

model Appointment {
  id               String                 @id @default(uuid())
  barbershopId     String                 @map("barbershop_id")
  memberId         String                 @map("member_id") // O barbeiro que executará o serviço
  customerId       String                 @map("customer_id") // O cliente que reservou
  dateTime         DateTime               @map("date_time") // Data e hora de início do atendimento
  totalPrice       Decimal                @map("total_price") @db.Decimal(10, 2)
  durationMin      Int                    @map("duration_min") // Soma das durações dos serviços escolhidos
  status           AppointmentStatus      @default(CONFIRMED)
  bookingMode      AppointmentBookingMode @default(NORMAL) @map("booking_mode")
  fitInReason      String?                @map("fit_in_reason")
  fitInCreatedById String?                @map("fit_in_created_by_id")
  fitInCreatedAt   DateTime?              @map("fit_in_created_at")
  conflictSnapshot Json?                  @map("conflict_snapshot")
  notes            String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  barbershop           Barbershop                       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber               BarbershopMember                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  customer             User                             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  services             AppointmentService[]
  review               Review?
  comandas             Comanda[]
  whatsappConfirmation AppointmentWhatsappConfirmation?
  fitInWaitlistEntries OnlineWaitlistEntry[]            @relation("WaitlistFitInAppointment")

  @@index([barbershopId, dateTime])
  @@index([memberId, dateTime])
  @@map("appointments")
}

// Confirmação semiautomática por WhatsApp, paralela ao status do agendamento
model AppointmentWhatsappConfirmation {
  id                       String                                 @id @default(uuid())
  barbershopId             String                                 @map("barbershop_id")
  appointmentId            String                                 @unique @map("appointment_id")
  customerPhone            String                                 @map("customer_phone")
  status                   WhatsappConfirmationStatus             @default(PENDING)
  tokenHash                String                                 @map("token_hash")
  tokenHint                String                                 @map("token_hint")
  expiresAt                DateTime?                              @map("expires_at")
  confirmedAt              DateTime?                              @map("confirmed_at")
  confirmedById            String?                                @map("confirmed_by_id")
  confirmationMethod       AppointmentWhatsappConfirmationMethod? @map("confirmation_method")
  manualConfirmationReason String?                                @map("manual_confirmation_reason")
  createdAt                DateTime                               @default(now()) @map("created_at")
  updatedAt                DateTime                               @updatedAt @map("updated_at")

  barbershop  Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  confirmedBy User?       @relation(fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([barbershopId, status])
  @@index([barbershopId, expiresAt])
  @@map("appointment_whatsapp_confirmations")
}

// Vínculo entre Cliente e Barbearia + Status de verificação WhatsApp por barbearia
model CustomerBarbershopLink {
  id                         String                                 @id @default(uuid())
  barbershopId               String                                 @map("barbershop_id")
  customerId                 String                                 @map("customer_id")
  whatsappVerifiedAt         DateTime?                              @map("whatsapp_verified_at")
  whatsappVerifiedById       String?                                @map("whatsapp_verified_by_id")
  whatsappVerificationMethod AppointmentWhatsappConfirmationMethod? @map("whatsapp_verification_method")
  createdAt                  DateTime                               @default(now()) @map("created_at")
  updatedAt                  DateTime                               @updatedAt @map("updated_at")

  barbershop         Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer           User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  whatsappVerifiedBy User?      @relation("WhatsappVerifiedBy", fields: [whatsappVerifiedById], references: [id], onDelete: SetNull)

  @@unique([barbershopId, customerId])
  @@index([barbershopId, customerId])
  @@map("customer_barbershop_links")
}

// Serviços atrelados ao agendamento (suporta múltiplos serviços no mesmo slot)
model AppointmentService {
  appointmentId String  @map("appointment_id")
  serviceId     String  @map("service_id")
  priceApplied  Decimal @map("price_applied") @db.Decimal(10, 2) // Salva o preço cobrado na época

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

// ----------------------------------------------------
// 6. AVALIAÇÕES E COMUNICAÇÃO
// ----------------------------------------------------

model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique @map("appointment_id")
  customerId    String   @map("customer_id")
  rating        Int // 1 a 5 estrelas
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer    User        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  content   String
  type      String // "APPOINTMENT_REMINDER", "APPOINTMENT_CONFIRMED", "SYSTEM_ALERT"
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ----------------------------------------------------
// 7. ASSINATURA DA PLATAFORMA (SAAS) E FINANCEIRO
// ----------------------------------------------------

enum PlanPeriod {
  MONTHLY
  YEARLY
}

model Plan {
  id          String     @id @default(uuid())
  name        String // Ex: "Bronze", "Prata", "Ouro"
  description String?
  price       Decimal    @db.Decimal(10, 2)
  period      PlanPeriod @default(MONTHLY)
  maxMembers  Int        @map("max_members") // Limite de barbeiros por plano
  isActive    Boolean    @default(true) @map("is_active")

  subscriptions TenantSubscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

model TenantSubscription {
  id                  String             @id @default(uuid())
  barbershopId        String             @map("barbershop_id")
  planId              String             @map("plan_id")
  status              SubscriptionStatus @default(TRIAL)
  planName            String?            @map("plan_name")
  monthlyPrice        Decimal?           @map("monthly_price") @db.Decimal(10, 2)
  trialEndsAt         DateTime?          @map("trial_ends_at")
  currentPeriodStart  DateTime?          @map("period_start")
  currentPeriodEnd    DateTime?          @map("period_end")
  gracePeriodEndsAt   DateTime?          @map("grace_period_ends_at")
  paymentMethod       String?            @map("payment_method")
  lastPaymentAt       DateTime?          @map("last_payment_at")
  lastAccessPaymentId String?            @map("last_access_payment_id")
  internalNotes       String?            @map("internal_notes")
  updatedBy           String?            @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id])

  @@map("tenant_subscriptions")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CommandPaymentStatus {
  CONFIRMED
  REFUNDED
}

enum ComandaStatus {
  OPEN
  IN_SERVICE
  PENDING_PAYMENT
  CLOSED
  CANCELLED
}

enum ComandaItemType {
  SERVICE
  PRODUCT
  DISCOUNT
  SURCHARGE
}

enum ComandaItemStatus {
  PENDING
  DONE
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
  OTHER
}

enum StockMovementType {
  SALE
  REFUND
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum FinancialEntryType {
  COMMAND_REVENUE
  REFUND
  MANUAL_IN
  MANUAL_OUT
  CLUB_REVENUE
  CLUB_BARBER_PAYOUT
}

model Comanda {
  id             String        @id @default(uuid())
  barbershopId   String        @map("barbershop_id")
  appointmentId  String?       @unique @map("appointment_id")
  customerId     String?       @map("customer_id")
  customerName   String        @map("customer_name")
  customerPhone  String?       @map("customer_phone")
  status         ComandaStatus @default(OPEN)
  subtotal       Decimal       @default(0) @db.Decimal(10, 2)
  discountTotal  Decimal       @default(0) @map("discount_total") @db.Decimal(10, 2)
  surchargeTotal Decimal       @default(0) @map("surcharge_total") @db.Decimal(10, 2)
  total          Decimal       @default(0) @db.Decimal(10, 2)
  paidTotal      Decimal       @default(0) @map("paid_total") @db.Decimal(10, 2)
  remainingTotal Decimal       @default(0) @map("remaining_total") @db.Decimal(10, 2)
  openedAt       DateTime      @default(now()) @map("opened_at")
  startedAt      DateTime?     @map("started_at")
  closedAt       DateTime?     @map("closed_at")
  cancelledAt    DateTime?     @map("cancelled_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  barbershop   Barbershop           @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointment  Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customer     User?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        ComandaItem[]
  payments     Payment[]
  reopenAudits ComandaReopenAudit[]
  cancelAudits ComandaCancelAudit[]

  @@index([barbershopId, status])
  @@index([barbershopId, openedAt])
  @@map("comandas")
}

model ComandaReopenAudit {
  id                     String        @id @default(uuid())
  barbershopId           String        @map("barbershop_id")
  comandaId              String        @map("comanda_id")
  reopenedByUserId       String        @map("reopened_by_user_id")
  reopenedByMemberId     String?       @map("reopened_by_member_id")
  reason                 String
  previousStatus         ComandaStatus @map("previous_status")
  newStatus              ComandaStatus @map("new_status")
  previousTotal          Decimal       @map("previous_total") @db.Decimal(10, 2)
  previousPaidTotal      Decimal       @map("previous_paid_total") @db.Decimal(10, 2)
  previousRemainingTotal Decimal       @map("previous_remaining_total") @db.Decimal(10, 2)
  newTotal               Decimal       @map("new_total") @db.Decimal(10, 2)
  newPaidTotal           Decimal       @map("new_paid_total") @db.Decimal(10, 2)
  newRemainingTotal      Decimal       @map("new_remaining_total") @db.Decimal(10, 2)
  createdAt              DateTime      @default(now()) @map("created_at")

  barbershop       Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  comanda          Comanda           @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  reopenedByUser   User              @relation(fields: [reopenedByUserId], references: [id], onDelete: Restrict)
  reopenedByMember BarbershopMember? @relation(fields: [reopenedByMemberId], references: [id], onDelete: SetNull)

  @@index([barbershopId, comandaId])
  @@index([reopenedByUserId])
  @@index([reopenedByMemberId])
  @@map("comanda_reopen_audits")
}

model ComandaCancelAudit {
  id                     String        @id @default(uuid())
  barbershopId           String        @map("barbershop_id")
  comandaId              String        @map("comanda_id")
  cancelledByUserId      String        @map("cancelled_by_user_id")
  cancelledByMemberId    String?       @map("cancelled_by_member_id")
  reason                 String
  previousStatus         ComandaStatus @map("previous_status")
  previousTotal          Decimal       @map("previous_total") @db.Decimal(10, 2)
  previousPaidTotal      Decimal       @map("previous_paid_total") @db.Decimal(10, 2)
  previousRemainingTotal Decimal       @map("previous_remaining_total") @db.Decimal(10, 2)
  refundedTotal          Decimal       @map("refunded_total") @db.Decimal(10, 2)
  newStatus              ComandaStatus @map("new_status")
  createdAt              DateTime      @default(now()) @map("created_at")

  barbershop        Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  comanda           Comanda           @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  cancelledByUser   User              @relation("ComandaCancelledByUser", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  cancelledByMember BarbershopMember? @relation("ComandaCancelledByMember", fields: [cancelledByMemberId], references: [id], onDelete: SetNull)

  @@index([barbershopId, comandaId])
  @@index([cancelledByUserId])
  @@index([cancelledByMemberId])
  @@map("comanda_cancel_audits")
}

model ComandaItem {
  id              String            @id @default(uuid())
  comandaId       String            @map("comanda_id")
  barbershopId    String            @map("barbershop_id")
  type            ComandaItemType
  status          ComandaItemStatus @default(PENDING)
  description     String
  quantity        Decimal           @default(1) @db.Decimal(10, 3)
  unitPrice       Decimal           @map("unit_price") @db.Decimal(10, 2)
  discountAmount  Decimal           @default(0) @map("discount_amount") @db.Decimal(10, 2)
  surchargeAmount Decimal           @default(0) @map("surcharge_amount") @db.Decimal(10, 2)
  total           Decimal           @db.Decimal(10, 2)
  serviceId       String?           @map("service_id")
  productId       String?           @map("product_id")
  executorId      String?           @map("executor_id")
  completedAt     DateTime?         @map("completed_at")
  cancelledAt     DateTime?         @map("cancelled_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  comanda                    Comanda           @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  service                    Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product                    Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  executor                   BarbershopMember? @relation(fields: [executorId], references: [id], onDelete: SetNull)
  clubBenefitRequested       Boolean           @default(false) @map("club_benefit_requested")
  requestedClubPlanBenefitId String?           @map("requested_club_plan_benefit_id")
  clubBenefitUsage           ClubBenefitUsage?
  clubPointEntry             ClubPointEntry?
  stockMovements             StockMovement[]
  commissionEntry            CommissionEntry?

  @@index([barbershopId, comandaId])
  @@index([executorId, status])
  @@map("comanda_items")
}

model Product {
  id           String   @id @default(uuid())
  barbershopId String   @map("barbershop_id")
  name         String
  description  String?
  salePrice    Decimal  @map("sale_price") @db.Decimal(10, 2)
  costPrice    Decimal? @map("cost_price") @db.Decimal(10, 2)
  unit         String   @default("un")
  isActive     Boolean  @default(true) @map("is_active")
  trackStock   Boolean  @default(false) @map("track_stock")
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(10, 3)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  barbershop        Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  items             ComandaItem[]
  movements         StockMovement[]
  commissionConfigs CommissionConfig[]
  clubPlanBenefits  ClubPlanBenefit[]
  clubBenefitUsages ClubBenefitUsage[]

  @@index([barbershopId, isActive])
  @@map("products")
}

model StockMovement {
  id            String            @id @default(uuid())
  barbershopId  String            @map("barbershop_id")
  productId     String            @map("product_id")
  comandaItemId String?           @map("comanda_item_id")
  type          StockMovementType
  quantity      Decimal           @db.Decimal(10, 3)
  description   String?
  createdAt     DateTime          @default(now()) @map("created_at")

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  comandaItem ComandaItem? @relation(fields: [comandaItemId], references: [id], onDelete: SetNull)

  @@index([barbershopId, productId, createdAt])
  @@map("stock_movements")
}

model Payment {
  id             String               @id @default(uuid())
  barbershopId   String               @map("barbershop_id")
  comandaId      String               @map("comanda_id")
  method         PaymentMethod
  amount         Decimal              @db.Decimal(10, 2)
  status         CommandPaymentStatus @default(CONFIRMED)
  idempotencyKey String?              @map("idempotency_key")
  paidAt         DateTime             @default(now()) @map("paid_at")
  receivedById   String?              @map("received_by_id")
  refundedAmount Decimal              @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  refundOfId     String?              @map("refund_of_id")
  refundReason   String?              @map("refund_reason")
  createdAt      DateTime             @default(now()) @map("created_at")

  comanda               Comanda                @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  refundOf              Payment?               @relation("PaymentRefund", fields: [refundOfId], references: [id], onDelete: Restrict)
  refunds               Payment[]              @relation("PaymentRefund")
  cashMovements         CashMovement[]
  financialEntries      FinancialEntry[]
  commissionAdjustments CommissionAdjustment[]

  @@unique([barbershopId, idempotencyKey])
  @@index([barbershopId, paidAt])
  @@index([comandaId])
  @@map("command_payments")
}

model CashSession {
  id             String            @id @default(uuid())
  barbershopId   String            @map("barbershop_id")
  status         CashSessionStatus @default(OPEN)
  openedById     String            @map("opened_by_id")
  openingAmount  Decimal           @map("opening_amount") @db.Decimal(10, 2)
  openedAt       DateTime          @default(now()) @map("opened_at")
  closedById     String?           @map("closed_by_id")
  closingAmount  Decimal?          @map("closing_amount") @db.Decimal(10, 2)
  expectedAmount Decimal           @default(0) @map("expected_amount") @db.Decimal(10, 2)
  difference     Decimal?          @db.Decimal(10, 2)
  closedAt       DateTime?         @map("closed_at")

  barbershop Barbershop     @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  movements  CashMovement[]

  @@index([barbershopId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id            String   @id @default(uuid())
  barbershopId  String   @map("barbershop_id")
  cashSessionId String   @map("cash_session_id")
  paymentId     String?  @map("payment_id")
  amount        Decimal  @db.Decimal(10, 2)
  description   String
  createdAt     DateTime @default(now()) @map("created_at")

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([barbershopId, cashSessionId, createdAt])
  @@map("cash_movements")
}

model FinancialEntry {
  id                        String             @id @default(uuid())
  barbershopId              String             @map("barbershop_id")
  type                      FinancialEntryType
  category                  String
  amount                    Decimal            @db.Decimal(10, 2)
  description               String
  entryDate                 DateTime           @default(now()) @map("entry_date")
  userId                    String?            @map("user_id")
  comandaId                 String?            @map("comanda_id")
  paymentId                 String?            @map("payment_id")
  clubSubscriptionPaymentId String?            @unique @map("club_subscription_payment_id")
  settlementId              String?            @map("settlement_id")
  settlementMemberId        String?            @unique @map("settlement_member_id")
  createdAt                 DateTime           @default(now()) @map("created_at")

  barbershop              Barbershop               @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  payment                 Payment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  clubSubscriptionPayment ClubSubscriptionPayment? @relation(fields: [clubSubscriptionPaymentId], references: [id], onDelete: SetNull)
  settlement              ClubSettlement?          @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  settlementMember        ClubSettlementMember?    @relation(fields: [settlementMemberId], references: [id], onDelete: SetNull)

  @@index([barbershopId, entryDate])
  @@index([barbershopId, type])
  @@index([settlementId])
  @@map("financial_entries")
}

enum CommissionType {
  SERVICE
  PRODUCT
}

enum CommissionConfigType {
  PERCENTAGE
  FIXED_VALUE
}

enum CommissionEntryStatus {
  GENERATED
  PARTIALLY_RELEASED
  RELEASED
  PAID
  REVERSED
}

enum CommissionPeriodStatus {
  OPEN
  CLOSED
  PAID
}

enum CommissionAdjustmentType {
  RELEASE
  REVERSAL
  PAID_ADJUSTMENT
}

model CommissionConfig {
  id           String               @id @default(uuid())
  barbershopId String               @map("barbershop_id")
  memberId     String?              @map("member_id")
  serviceId    String?              @map("service_id")
  categoryId   String?              @map("category_id")
  productId    String?              @map("product_id")
  scopeKey     String               @map("scope_key")
  type         CommissionConfigType
  value        Decimal              @db.Decimal(10, 2)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  barbershop Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  member     BarbershopMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  service    Service?          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category   Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  entries    CommissionEntry[]

  @@unique([barbershopId, scopeKey])
  @@index([barbershopId, active])
  @@index([memberId])
  @@index([serviceId])
  @@index([categoryId])
  @@index([productId])
  @@map("commission_configs")
}

model CommissionEntry {
  id              String                @id @default(uuid())
  barbershopId    String                @map("barbershop_id")
  comandaItemId   String                @unique @map("comanda_item_id")
  memberId        String                @map("member_id")
  configId        String?               @map("config_id")
  configSnapshot  Json                  @map("config_snapshot")
  baseAmount      Decimal               @map("base_amount") @db.Decimal(10, 2)
  generatedAmount Decimal               @map("generated_amount") @db.Decimal(10, 2)
  releasedAmount  Decimal               @default(0) @map("released_amount") @db.Decimal(10, 2)
  paidAmount      Decimal               @default(0) @map("paid_amount") @db.Decimal(10, 2)
  reversedAmount  Decimal               @default(0) @map("reversed_amount") @db.Decimal(10, 2)
  competence      String
  status          CommissionEntryStatus @default(GENERATED)
  type            CommissionType        @default(SERVICE)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  barbershop  Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  comandaItem ComandaItem            @relation(fields: [comandaItemId], references: [id], onDelete: Cascade)
  member      BarbershopMember       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  config      CommissionConfig?      @relation(fields: [configId], references: [id], onDelete: SetNull)
  adjustments CommissionAdjustment[]

  @@index([barbershopId, competence])
  @@index([barbershopId, status])
  @@index([memberId, competence])
  @@map("commission_entries")
}

model CommissionPeriod {
  id              String                 @id @default(uuid())
  barbershopId    String                 @map("barbershop_id")
  memberId        String                 @map("member_id")
  competence      String
  status          CommissionPeriodStatus @default(OPEN)
  generatedAmount Decimal                @default(0) @map("generated_amount") @db.Decimal(10, 2)
  releasedAmount  Decimal                @default(0) @map("released_amount") @db.Decimal(10, 2)
  paidAmount      Decimal                @default(0) @map("paid_amount") @db.Decimal(10, 2)
  reversedAmount  Decimal                @default(0) @map("reversed_amount") @db.Decimal(10, 2)
  balanceAmount   Decimal                @default(0) @map("balance_amount") @db.Decimal(10, 2)
  closedAt        DateTime?              @map("closed_at")
  paidAt          DateTime?              @map("paid_at")
  closedById      String?                @map("closed_by_id")
  paidById        String?                @map("paid_by_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  barbershop Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  member     BarbershopMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([barbershopId, memberId, competence])
  @@index([barbershopId, competence])
  @@index([barbershopId, status])
  @@map("commission_periods")
}

model CommissionAdjustment {
  id                     String                   @id @default(uuid())
  barbershopId           String                   @map("barbershop_id")
  entryId                String?                  @map("entry_id")
  memberId               String                   @map("member_id")
  paymentId              String?                  @map("payment_id")
  type                   CommissionAdjustmentType
  amount                 Decimal                  @db.Decimal(10, 2)
  competence             String
  description            String
  rolloverFromCompetence String?                  @map("rollover_from_competence")
  createdAt              DateTime                 @default(now()) @map("created_at")

  barbershop Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  entry      CommissionEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  member     BarbershopMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  payment    Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([barbershopId, memberId, competence, rolloverFromCompetence])
  @@index([barbershopId, competence])
  @@index([memberId, competence])
  @@index([paymentId])
  @@index([rolloverFromCompetence])
  @@map("commission_adjustments")
}

// ----------------------------------------------------
// 7.1 PLANO DE CARREIRA E MATRIZ DE COMISSÃO (COMISSÃO 2.0)
// Ordem de Fallback da Comissão 2.0 (Resolução futura de comissão):
// 1. CommissionConfig individual por membro + serviço (memberId + serviceId)
// 2. CommissionConfig individual por membro + categoria (memberId + categoryId)
// 3. CommissionConfig individual default do membro (memberId + default)
// 4. ServiceCommissionRule por serviço + nível (serviceId + careerLevelId)
// 5. CommissionConfig padrão do serviço (serviceId)
// 6. CommissionConfig padrão da categoria (categoryId)
// 7. CommissionConfig padrão do produto, quando aplicável (productId)
// 8. CareerLevel.defaultCommissionRate
// 9. CommissionConfig padrão da barbearia (barbershop:default)
// ----------------------------------------------------

model CareerLevel {
  id                    String   @id @default(uuid())
  barbershopId          String   @map("barbershop_id")
  name                  String
  description           String?
  sortOrder             Int      @default(0) @map("sort_order")
  defaultCommissionRate Decimal? @map("default_commission_rate") @db.Decimal(10, 2)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  barbershop Barbershop              @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  members    BarbershopMember[]
  rules      ServiceCommissionRule[]

  @@unique([barbershopId, name])
  @@index([barbershopId, active])
  @@map("career_levels")
}

model ServiceCommissionRule {
  id             String               @id @default(uuid())
  barbershopId   String               @map("barbershop_id")
  serviceId      String               @map("service_id")
  careerLevelId  String               @map("career_level_id")
  type           CommissionConfigType @default(PERCENTAGE)
  commissionRate Decimal              @map("commission_rate") @db.Decimal(10, 2)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  barbershop  Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  careerLevel CareerLevel @relation(fields: [careerLevelId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, serviceId, careerLevelId])
  @@index([barbershopId, serviceId])
  @@index([barbershopId, careerLevelId])
  @@map("service_commission_rules")
}

// ----------------------------------------------------
// 8. PLANO CLUBE (ASSINATURA DE CLIENTES)
// ----------------------------------------------------

enum ClubPlanBenefitType {
  INCLUDED_SERVICE
  SERVICE_DISCOUNT
  PRODUCT_DISCOUNT
}

enum ClubSubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

enum ClubPaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELED
}

enum ClubPointStatus {
  GENERATED
  SETTLED
  REVERSED
}

enum ClubSettlementStatus {
  CALCULATED
  APPROVED
  PAID
  CANCELED
}

enum ClubBenefitLimitMode {
  UNLIMITED
  MONTHLY_LIMIT
}

enum ClubBenefitUsageStatus {
  APPLIED
  REVERSED
}

model ClubPlan {
  id                String   @id @default(uuid())
  barbershopId      String   @map("barbershop_id")
  name              String
  description       String?
  monthlyPrice      Decimal  @map("monthly_price") @db.Decimal(10, 2)
  shopSharePercent  Decimal  @map("shop_share_percent") @db.Decimal(5, 2)
  barberPoolPercent Decimal  @map("barber_pool_percent") @db.Decimal(5, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  barbershop               Barbershop                 @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  benefits                 ClubPlanBenefit[]
  subscriptions            CustomerClubSubscription[]
  clubSubscriptionPayments ClubSubscriptionPayment[]
  clubBenefitUsages        ClubBenefitUsage[]

  @@index([barbershopId, isActive])
  @@map("club_plans")
}

model ClubPlanBenefit {
  id               String               @id @default(uuid())
  clubPlanId       String               @map("club_plan_id")
  benefitType      ClubPlanBenefitType  @map("benefit_type")
  benefitLimitMode ClubBenefitLimitMode @default(MONTHLY_LIMIT) @map("benefit_limit_mode")
  serviceId        String?              @map("service_id")
  productId        String?              @map("product_id")
  includedQty      Int?                 @map("included_qty")
  discountPercent  Decimal?             @map("discount_percent") @db.Decimal(5, 2)
  pointWeight      Decimal?             @map("point_weight") @db.Decimal(10, 4)

  clubPlan          ClubPlan           @relation(fields: [clubPlanId], references: [id], onDelete: Cascade)
  service           Service?           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  clubBenefitUsages ClubBenefitUsage[]

  @@index([clubPlanId])
  @@index([serviceId])
  @@index([productId])
  @@map("club_plan_benefits")
}

model CustomerClubSubscription {
  id                 String                 @id @default(uuid())
  barbershopId       String                 @map("barbershop_id")
  customerId         String                 @map("customer_id")
  clubPlanId         String                 @map("club_plan_id")
  status             ClubSubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime               @map("current_period_start")
  currentPeriodEnd   DateTime               @map("current_period_end")
  gracePeriodEnd     DateTime               @map("grace_period_end")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  barbershop   Barbershop                @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer     User                      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  clubPlan     ClubPlan                  @relation(fields: [clubPlanId], references: [id])
  payments     ClubSubscriptionPayment[]
  usages       ClubBenefitUsage[]
  pointEntries ClubPointEntry[]

  @@index([barbershopId, customerId])
  @@index([barbershopId, status])
  @@map("customer_club_subscriptions")
}

model ClubSubscriptionPayment {
  id                        String            @id @default(uuid())
  barbershopId              String            @map("barbershop_id")
  subscriptionId            String            @map("subscription_id")
  customerId                String            @map("customer_id")
  clubPlanId                String            @map("club_plan_id")
  amount                    Decimal           @db.Decimal(10, 2)
  paymentMethod             PaymentMethod     @map("payment_method")
  status                    ClubPaymentStatus @default(PAID)
  competence                String
  shopSharePercentSnapshot  Decimal           @map("shop_share_percent_snapshot") @db.Decimal(5, 2)
  barberPoolPercentSnapshot Decimal           @map("barber_pool_percent_snapshot") @db.Decimal(5, 2)
  paidAt                    DateTime          @map("paid_at")
  createdAt                 DateTime          @default(now()) @map("created_at")

  barbershop     Barbershop               @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  subscription   CustomerClubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customer       User                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  clubPlan       ClubPlan                 @relation(fields: [clubPlanId], references: [id])
  financialEntry FinancialEntry?

  @@index([barbershopId, subscriptionId])
  @@index([customerId])
  @@index([clubPlanId])
  @@index([paidAt])
  @@map("club_subscription_payments")
}

model ClubBenefitUsage {
  id                 String                 @id @default(uuid())
  barbershopId       String                 @map("barbershop_id")
  subscriptionId     String                 @map("subscription_id")
  clubPlanId         String                 @map("club_plan_id")
  clubPlanBenefitId  String?                @map("club_plan_benefit_id")
  comandaItemId      String                 @unique @map("comanda_item_id")
  serviceId          String?                @map("service_id")
  productId          String?                @map("product_id")
  benefitType        ClubPlanBenefitType    @map("benefit_type")
  originalAmount     Decimal?               @map("original_amount") @db.Decimal(10, 2)
  coveredAmount      Decimal?               @map("covered_amount") @db.Decimal(10, 2)
  discountAmount     Decimal?               @map("discount_amount") @db.Decimal(10, 2)
  pointWeightApplied Decimal?               @map("point_weight_applied") @db.Decimal(10, 4)
  status             ClubBenefitUsageStatus @default(APPLIED)
  competence         String
  usedAt             DateTime               @map("used_at")
  reversedAt         DateTime?              @map("reversed_at")
  reversalReason     String?                @map("reversal_reason")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  barbershop      Barbershop               @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  subscription    CustomerClubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  clubPlan        ClubPlan                 @relation(fields: [clubPlanId], references: [id])
  clubPlanBenefit ClubPlanBenefit?         @relation(fields: [clubPlanBenefitId], references: [id], onDelete: SetNull)
  comandaItem     ComandaItem              @relation(fields: [comandaItemId], references: [id], onDelete: Cascade)
  service         Service?                 @relation(fields: [serviceId], references: [id])
  product         Product?                 @relation(fields: [productId], references: [id])

  @@index([barbershopId, subscriptionId])
  @@index([clubPlanId])
  @@index([clubPlanBenefitId])
  @@map("club_benefit_usages")
}

model ClubPointEntry {
  id             String          @id @default(uuid())
  barbershopId   String          @map("barbershop_id")
  subscriptionId String?         @map("subscription_id")
  comandaItemId  String          @unique @map("comanda_item_id")
  memberId       String          @map("member_id")
  points         Decimal         @db.Decimal(10, 4)
  status         ClubPointStatus @default(GENERATED)
  competence     String
  settlementId   String?         @map("settlement_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  barbershop   Barbershop                @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  subscription CustomerClubSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  comandaItem  ComandaItem               @relation(fields: [comandaItemId], references: [id], onDelete: Cascade)
  member       BarbershopMember          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  settlement   ClubSettlement?           @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([barbershopId, competence])
  @@index([memberId, competence])
  @@index([settlementId])
  @@map("club_point_entries")
}

model ClubSettlement {
  id               String   @id @default(uuid())
  barbershopId     String   @map("barbershop_id")
  competence       String
  totalRevenue     Decimal  @map("total_revenue") @db.Decimal(10, 2)
  shopSharePercent Decimal? @map("shop_share_percent") @db.Decimal(5, 2)
  shopAmount       Decimal  @map("shop_amount") @db.Decimal(10, 2)

  // barberPoolAmount representa o fundo total disponível no mês (soma do rateio do mês + carryInAmount)
  barberPoolAmount Decimal @map("barber_pool_amount") @db.Decimal(10, 2)

  carryInAmount  Decimal @default(0) @map("carry_in_amount") @db.Decimal(10, 2)
  carryOutAmount Decimal @default(0) @map("carry_out_amount") @db.Decimal(10, 2)

  totalPoints Decimal              @map("total_points") @db.Decimal(10, 4)
  status      ClubSettlementStatus @default(CALCULATED)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  barbershop       Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  members          ClubSettlementMember[]
  pointEntries     ClubPointEntry[]
  financialEntries FinancialEntry[]

  @@unique([barbershopId, competence])
  @@map("club_settlements")
}

model ClubSettlementMember {
  id           String    @id @default(uuid())
  settlementId String    @map("settlement_id")
  memberId     String    @map("member_id")
  points       Decimal   @db.Decimal(10, 4)
  amount       Decimal   @db.Decimal(10, 2)
  paidAt       DateTime? @map("paid_at")

  settlement     ClubSettlement   @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  member         BarbershopMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  financialEntry FinancialEntry?

  @@unique([settlementId, memberId])
  @@map("club_settlement_members")
}

// ----------------------------------------------------
// 12. FILA DE ESPERA ONLINE (WAITLIST)
// ----------------------------------------------------

enum OnlineWaitlistSessionStatus {
  OPEN
  PAUSED
  CLOSED
}

enum OnlineWaitlistEntryStatus {
  WAITING
  CALLED
  FIT_IN_CREATED
  IN_SERVICE
  COMPLETED
  SKIPPED
  NO_SHOW
  MOVED_TO_END
  CANCELED_BY_CUSTOMER
  CANCELED_BY_SHOP
  EXPIRED
}

model OnlineWaitlistSession {
  id                                  String                      @id @default(cuid())
  barbershopId                        String                      @map("barbershop_id")
  status                              OnlineWaitlistSessionStatus @default(OPEN)
  openedAt                            DateTime                    @default(now()) @map("opened_at")
  closedAt                            DateTime?                   @map("closed_at")
  title                               String?
  notes                               String?
  defaultLockBeforeAppointmentMinutes Int                         @default(20) @map("default_lock_before_appointment_minutes")
  createdById                         String?                     @map("created_by_id")
  createdAt                           DateTime                    @default(now()) @map("created_at")
  updatedAt                           DateTime                    @updatedAt @map("updated_at")

  barbershop Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdBy  User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  entries    OnlineWaitlistEntry[]

  @@index([barbershopId, status])
  @@map("online_waitlist_sessions")
}

model OnlineWaitlistEntry {
  id                 String                    @id @default(cuid())
  sessionId          String                    @map("session_id")
  barbershopId       String                    @map("barbershop_id")
  customerId         String?                   @map("customer_id")
  customerName       String                    @map("customer_name")
  customerPhone      String                    @map("customer_phone")
  serviceId          String                    @map("service_id")
  preferredMemberId  String?                   @map("preferred_member_id")
  queueNumber        Int                       @map("queue_number")
  positionWeight     Int                       @map("position_weight")
  status             OnlineWaitlistEntryStatus @default(WAITING)
  skipCount          Int                       @default(0) @map("skip_count")
  noShowCount        Int                       @default(0) @map("no_show_count")
  publicTokenHash    String                    @map("public_token_hash")
  publicTokenHint    String?                   @map("public_token_hint")
  calledByMemberId   String?                   @map("called_by_member_id")
  calledAt           DateTime?                 @map("called_at")
  fitInAppointmentId String?                   @map("fit_in_appointment_id")
  canceledAt         DateTime?                 @map("canceled_at")
  completedAt        DateTime?                 @map("completed_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  session          OnlineWaitlistSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  barbershop       Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  customer         User?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service          Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  preferredMember  BarbershopMember?     @relation("WaitlistPreferredMember", fields: [preferredMemberId], references: [id], onDelete: SetNull)
  calledByMember   BarbershopMember?     @relation("WaitlistCalledByMember", fields: [calledByMemberId], references: [id], onDelete: SetNull)
  fitInAppointment Appointment?          @relation("WaitlistFitInAppointment", fields: [fitInAppointmentId], references: [id], onDelete: SetNull)

  @@index([sessionId, status])
  @@index([barbershopId, status])
  @@index([publicTokenHash])
  @@index([customerId])
  @@map("online_waitlist_entries")
}

model OnlineWaitlistMemberConfig {
  id                           String   @id @default(cuid())
  barbershopId                 String   @map("barbershop_id")
  memberId                     String   @unique @map("member_id")
  enabled                      Boolean  @default(true)
  lockBeforeAppointmentMinutes Int      @default(20) @map("lock_before_appointment_minutes")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  barbershop Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  member     BarbershopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, memberId])
  @@map("online_waitlist_member_configs")
}

// ----------------------------------------------------
// 12. ASAAS BILLING FOUNDATION (SAAS TENANT SUBSCRIPTIONS)
// ----------------------------------------------------

enum BillingPersonType {
  INDIVIDUAL
  COMPANY
}

model BarbershopBillingProfile {
  id           String            @id @default(uuid())
  barbershopId String            @unique @map("barbershop_id")
  personType   BillingPersonType @map("person_type")
  legalName    String            @map("legal_name")
  cpfCnpj      String            @map("cpf_cnpj")
  billingEmail String            @map("billing_email")
  billingPhone String?           @map("billing_phone")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@map("barbershop_billing_profiles")
}

enum AsaasBillingEnvironment {
  SANDBOX
  PRODUCTION
}

enum AsaasSubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  OVERDUE
  CANCELED
  UNKNOWN
}

enum AsaasPaymentStatus {
  PENDING
  RECEIVED
  CONFIRMED
  OVERDUE
  REFUNDED
  CANCELED
  CHARGEBACK
  UNKNOWN
}

enum AsaasWebhookProcessingStatus {
  PENDING
  PROCESSED
  IGNORED
  FAILED
}

model AsaasBillingCustomer {
  id                String   @id @default(uuid())
  barbershopId      String   @map("barbershop_id")
  asaasCustomerId   String   @unique @map("asaas_customer_id")
  name              String
  email             String?
  cpfCnpj           String?  @map("cpf_cnpj")
  phone             String?
  externalReference String   @map("external_reference")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([externalReference])
  @@map("asaas_billing_customers")
}

model AsaasBillingSubscription {
  id                  String                  @id @default(uuid())
  barbershopId        String                  @map("barbershop_id")
  asaasSubscriptionId String                  @unique @map("asaas_subscription_id")
  asaasCustomerId     String                  @map("asaas_customer_id")
  planCode            String                  @map("plan_code")
  planName            String                  @map("plan_name")
  value               Decimal                 @db.Decimal(10, 2)
  cycle               String                  @default("MONTHLY")
  status              AsaasSubscriptionStatus @default(UNKNOWN)
  nextDueDate         DateTime?               @map("next_due_date")
  billingType         String?                 @map("billing_type")
  externalReference   String                  @map("external_reference")
  canceledAt          DateTime?               @map("canceled_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([asaasCustomerId])
  @@index([externalReference])
  @@index([status])
  @@map("asaas_billing_subscriptions")
}

model AsaasBillingPayment {
  id                  String             @id @default(uuid())
  barbershopId        String             @map("barbershop_id")
  asaasPaymentId      String             @unique @map("asaas_payment_id")
  asaasSubscriptionId String?            @map("asaas_subscription_id")
  asaasCustomerId     String?            @map("asaas_customer_id")
  status              AsaasPaymentStatus @default(UNKNOWN)
  billingType         String?            @map("billing_type")
  value               Decimal            @db.Decimal(10, 2)
  netValue            Decimal?           @map("net_value") @db.Decimal(10, 2)
  dueDate             DateTime?          @map("due_date")
  paymentDate         DateTime?          @map("payment_date")
  invoiceUrl          String?            @map("invoice_url")
  bankSlipUrl         String?            @map("bank_slip_url")
  externalReference   String?            @map("external_reference")
  accessAppliedAt     DateTime?          @map("access_applied_at")
  rawPayload          Json?              @map("raw_payload")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([asaasSubscriptionId])
  @@index([asaasCustomerId])
  @@index([externalReference])
  @@index([status])
  @@map("asaas_billing_payments")
}

model AsaasWebhookEvent {
  id                String                       @id @default(uuid())
  event             String
  asaasEventId      String?                      @map("asaas_event_id")
  paymentId         String?                      @map("payment_id")
  subscriptionId    String?                      @map("subscription_id")
  customerId        String?                      @map("customer_id")
  barbershopId      String?                      @map("barbershop_id")
  externalReference String?                      @map("external_reference")
  payload           Json
  processedAt       DateTime?                    @map("processed_at")
  processingStatus  AsaasWebhookProcessingStatus @default(PENDING) @map("processing_status")
  processingError   String?                      @map("processing_error")
  receivedAt        DateTime                     @default(now()) @map("received_at")
  createdAt         DateTime                     @default(now()) @map("created_at")

  barbershop Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([processingStatus])
  @@index([barbershopId])
  @@index([externalReference])
  @@map("asaas_webhook_events")
}

model BarbershopBlockedCustomer {
  id                  String    @id @default(uuid())
  barbershopId        String    @map("barbershop_id")
  userId              String?   @map("user_id")
  phoneNormalized     String    @map("phone_normalized")
  nameSnapshot        String?   @map("name_snapshot")
  reason              String
  active              Boolean   @default(true)
  blockedByUserId     String?   @map("blocked_by_user_id")
  blockedByMemberId   String?   @map("blocked_by_member_id")
  blockedAt           DateTime  @default(now()) @map("blocked_at")
  unblockedByUserId   String?   @map("unblocked_by_user_id")
  unblockedByMemberId String?   @map("unblocked_by_member_id")
  unblockedAt         DateTime? @map("unblocked_at")
  unblockReason       String?   @map("unblock_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  barbershop        Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  blockedByUser     User?             @relation("BlockedByUser", fields: [blockedByUserId], references: [id], onDelete: SetNull)
  blockedByMember   BarbershopMember? @relation("BlockedByMember", fields: [blockedByMemberId], references: [id], onDelete: SetNull)
  unblockedByUser   User?             @relation("UnblockedByUser", fields: [unblockedByUserId], references: [id], onDelete: SetNull)
  unblockedByMember BarbershopMember? @relation("UnblockedByMember", fields: [unblockedByMemberId], references: [id], onDelete: SetNull)

  @@unique([barbershopId, phoneNormalized])
  @@index([barbershopId, active])
  @@index([userId])
  @@map("barbershop_blocked_customers")
}
